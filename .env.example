# Copiar a .env y ajustar valores. Nunca subir el .env real al repositorio.
APP_ENV=local
APP_DEBUG=1
APP_BASE_URL=/Proyecto-TeMa
# URL pública del sitio (para enlaces absolutos en correos; en web se autodetecta)
APP_URL=http://localhost

DB_HOST=localhost
DB_NAME=tentaciones_marlly
DB_USER=root
DB_PASS=

SESSION_TIMEOUT=1800
LOCKOUT_ATTEMPTS=3
LOCKOUT_MINUTES=1

# --- Correo de recuperación (restaurado de bda5c73, saneado: sin hardcode) ---
# Vacío = modo local (el enlace se muestra en pantalla con APP_DEBUG=1).
# Para envío real (Gmail con App Password de 16 letras, NO la clave normal):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Tentaciones Marlly

